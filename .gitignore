# Logs.
# Daemon logs contain Authorization headers, so a stray capture left in a
# working tree is a credential disclosure waiting for `git add -A`. Match
# the plural and dotted variants too -- redfish.logs and ironic.logs have
# both turned up on a deployed host, world-readable and untracked.
*.log
*.logs
*.log.*
logs/
redfish.logs
ironic.logs

# Test coverage
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Temporary files
*.tmp
*.temp
/tmp/
/temp/

# Backup files
*.bak
*.backup
*-original
*-working-*
backup/

# ISO files (if accidentally committed)
*.iso

# SSL certificates and keys
*.crt
*.key
*.pem
*.p12
*.pfx
config/ssl/*.crt
config/ssl/*.key
config/ssl/*.pem 
# Contract-test snapshots. These are captures from a REAL host and contain
# MAC addresses, hostnames, storage names and task ids. Never commit them.
tests/contract/snapshots/
*.snapshot.json
