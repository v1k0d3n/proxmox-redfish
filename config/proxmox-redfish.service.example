# Example systemd unit. scripts/install.sh writes this for you, with the
# paths it installed to; this copy is for a hand-built installation.
#
# Configuration lives in the EnvironmentFile rather than in Environment=
# lines here: `systemctl show` prints unit settings to any local user, and a
# separate file can be mode 600. See config/params.env.example.

[Unit]
Description=Proxmox Redfish Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/opt/proxmox-redfish/config/params.env
ExecStart=/opt/proxmox-redfish/venv/bin/proxmox-redfish
WorkingDirectory=/opt/proxmox-redfish
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
